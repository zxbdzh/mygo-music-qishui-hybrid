{
  "id": "qishui-app-login",
  "name": "汽水音乐",
  "version": "1.2.1",
  "minAppVersion": "0.1.20",
  "main": "index.js",
  "icon": "icon.png",
  "playback": "stream",
  "settings": [
    {
      "key": "externalSourceEnabled",
      "label": "使用外部音源",
      "type": "boolean",
      "help": "开启后先向音源取直链，拿不到合规直链时自动回落官方播放；关闭时不发出任何音源请求。"
    },
    {
      "key": "externalSourceScript",
      "label": "LX 音源脚本地址",
      "help": "填完整的 LX 脚本地址，必须以 https:// 开头，例如 https://source.shiqianjiang.cn/api/script/lx?key=…。只读取脚本声明的接口，不执行脚本；更换地址后下一次播放重新读取。"
    }
  ],
  "navigation": [
    {
      "title": "首页",
      "builtin": "home",
      "icon": "home"
    },
    {
      "title": "收藏专辑",
      "builtin": "savedAlbums",
      "icon": "album"
    },
    {
      "title": "推荐",
      "builtin": "stations",
      "icon": "star"
    },
    {
      "title": "听歌模式",
      "page": "listening-modes",
      "icon": "radio"
    }
  ],
  "permissions": {
    "network": [
      "*"
    ],
    "process": [
      "bin/qishui-helper-*"
    ]
  }
}
